DEBUG=True
PORTAIL_CODE_DEMO=True
SECRET_KEY=change-moi-en-une-vraie-cle-secrete

DB_NAME=medihub
DB_USER=medihub_app
DB_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optionnel : stockage de photos de médecins compatible S3 (ex. Railway Storage Bucket).
# Sans bucket, les médias sont stockés localement dans ./media en développement.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sur des domaines distincts en production HTTPS, configure les cookies cross-site :
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
