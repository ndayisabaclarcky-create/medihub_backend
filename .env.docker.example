# Copie ce fichier sous le nom .env.docker avant docker compose up.
# Valeurs uniquement pour le développement local : choisis des secrets distincts en production.
SECRET_KEY=local-docker-change-this-secret-key
DEBUG=False
PORTAIL_CODE_DEMO=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False

DB_NAME=medihub
DB_USER=medihub_app
DB_PASSWORD=local-only-change-this-app-password
DB_HOST=postgres
DB_PORT=5432
POSTGRES_ADMIN_PASSWORD=local-only-change-this-postgres-password

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001

# Railway Storage / S3 optionnel. Les fichiers médias locaux ne survivent pas
# à la suppression du conteneur en production.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
